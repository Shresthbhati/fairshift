{
  "name": "fairshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset && node --no-warnings --env-file=.env.local scripts/seed.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "check": "node scripts/check-i18n.ts && node scripts/check-no-service-role.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "2.122.0",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.30.1"
}
