NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # from `pnpm supabase status -o env` (ANON_KEY or PUBLISHABLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=            # from `pnpm supabase status -o env` (SERVICE_ROLE_KEY or SECRET_KEY), server only
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=                        # choose locally; never commit
GEMINI_API_KEY=                       # optional (COULD 18)
GEMINI_MODEL=                         # optional: current Flash model id from Google AI Studio
